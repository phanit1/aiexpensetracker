PORT=4000
JWT_SECRET=replace-this-with-a-long-random-secret
# Option A: Supabase Postgres using the project's connection string (Session pooler recommended)
DATABASE_URL=postgresql://postgres:password@localhost:5432/expenseai
# AI insights are generated locally when no Gemini key is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
